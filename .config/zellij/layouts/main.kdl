layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }

    new_tab_template {
        pane borderless=true
    }

    tab name="1" {
        pane borderless=true
    }
    tab name="2" {
        pane borderless=true
    }
    tab name="3" {
        pane borderless=true
    }
    tab name="4" {
        pane borderless=true
    }
    tab name="5" {
        pane borderless=true
    }
    tab name="6" {
        pane borderless=true
    }
    tab name="7" {
        pane borderless=true
    }
    tab name="8" {
        pane borderless=true
    }
    tab name="9" {
        pane borderless=true
    }
    tab name="10" {
        pane borderless=true
    }
}
