#!/usr/bin/env -S python3 -I
"""Per-session 1Password secrets for Claude Code agent sessions.

Agent shells have no TTY, so every `op` process asks for Touch ID again. This
tool keeps one small helper process per Claude session (keyed by the session
ID and the session's Claude PID). The helper fetches secrets with one
`op inject` per batch, holds them in memory only, and hands them to commands
started through `op-secret run`, whose output is masked. Nothing is written to
disk except the socket, a session token, a lock and a log without values, all
in an owner-only directory under /tmp. The helper exits when its Claude
process does.

Usage inside a Claude session:
  op-secret run NAME=op://vault/item/field [NAME=op://...]... -- COMMAND [ARGS...]
  op-secret check NAME=op://... [...]       length + salted scrypt hash
  op-secret check --stdin NAME=op://...     compare stdin: "matches"/"differs"
  op-secret forget op://vault/item/field     drop one cached secret

Usage anywhere:
  op-secret list
  op-secret stop --session ID | --pid N | --all
"""

import calendar
import errno
import fcntl
import hashlib
import hmac
import json
import os
import pwd
import re
import secrets
import shutil
import signal
import socket
import stat
import struct
import subprocess
import sys
import threading
import time

# From the account database, not the environment, so a caller can't point
# the helper or `op` at another home folder or runtime dir.
_ACCOUNT = pwd.getpwuid(os.getuid())
USER = _ACCOUNT.pw_name
RUNTIME_DIR = f"/tmp/op-secret-{USER}"

# Slightly longer than 1Password's own approval prompt, so the client always
# sees the real outcome (approved, denied or timed out).
CLIENT_WAIT = 180
OP_TIMEOUT = 300
CONNECT_WAIT = 5
POLL_INTERVAL = 5
CONN_TIMEOUT = 15
DENY_MEMORY = 60
# macOS's nightly tmp_cleaner deletes files in /tmp untouched for 3 days, so
# an idle helper refreshes its files' timestamps well inside that window.
TOUCH_INTERVAL = 24 * 3600
MAX_REFS = 50
MAX_REQUEST = 64 * 1024
MIN_SECRET_LEN = 8
MASK = b"<concealed>"

# Peer PID of a connected AF_UNIX socket on macOS (sys/un.h). Linux uses
# SO_PEERCRED instead; see peer_pid().
SOL_LOCAL = 0
LOCAL_PEERPID = 0x002

NAME_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
REF_RE = re.compile(r"^op://[^\n\r{}]+$")
SESSION_RE = re.compile(r"^[A-Za-z0-9._-]{1,80}$")
DENIED_NAMES = {
    "PATH",
    "HOME",
    "USER",
    "LOGNAME",
    "SHELL",
    "TMPDIR",
    "PWD",
    "OLDPWD",
    "IFS",
    "BASH_ENV",
    "ENV",
    "PROMPT_COMMAND",
    "TERM",
    "LANG",
}
DENIED_PREFIXES = ("DYLD_", "LD_", "PYTHON", "OP_", "CLAUDE_", "LC_", "BASH_FUNC_")
PS_LINE_RE = re.compile(
    r"^\s*(\d+)\s+(\d+)\s+(\w{3}\s+\w{3}\s+\d{1,2}\s+\d\d:\d\d:\d\d\s+\d{4})\s+(.*)$"
)


class Error(Exception):
    pass


# ---------------------------------------------------------------- shared


def clean_env():
    """A minimal environment for the helper and `op`: never the caller's,
    which may hold a repo's secrets, stray op:// values, or OP_* settings that
    would switch `op` to another identity."""
    home = _ACCOUNT.pw_dir
    env = {
        "HOME": home,
        "USER": USER,
        "LOGNAME": USER,
        "LANG": "C",
        "PATH": ":".join(
            [
                f"{home}/.nix-profile/bin",
                "/nix/var/nix/profiles/default/bin",
                "/opt/homebrew/bin",
                "/usr/local/bin",
                "/usr/bin",
                "/bin",
                "/usr/sbin",
                "/sbin",
            ]
        ),
    }
    for name in ("TMPDIR", "OP_ACCOUNT"):
        if os.environ.get(name):
            env[name] = os.environ[name]
    return env


def runtime_dir():
    try:
        os.mkdir(RUNTIME_DIR, 0o700)
    except FileExistsError:
        pass
    st = os.lstat(RUNTIME_DIR)
    if (
        not stat.S_ISDIR(st.st_mode)
        or st.st_uid != os.getuid()
        or stat.S_IMODE(st.st_mode) != 0o700
    ):
        raise Error(
            f"unsafe runtime dir {RUNTIME_DIR}: must be a directory owned by you with mode 700"
        )
    return RUNTIME_DIR


def helper_paths(session, claude_pid):
    base = os.path.join(runtime_dir(), f"{session}-{claude_pid}")
    paths = {kind: f"{base}.{kind}" for kind in ("sock", "token", "lock", "log")}
    if len(paths["sock"].encode()) >= 104:
        raise Error("socket path too long")
    return paths


def check_name(name):
    if not NAME_RE.fullmatch(name):
        raise Error(f"invalid variable name: {name!r}")
    if name in DENIED_NAMES or name.startswith(DENIED_PREFIXES):
        raise Error(f"refusing to set {name}: it would change how the command runs")


def check_ref(ref):
    if not REF_RE.fullmatch(ref):
        raise Error(
            f"invalid 1Password reference: {ref!r} (expected op://vault/item/field)"
        )


def check_refs(refs):
    if not isinstance(refs, dict) or not refs:
        raise Error("no secrets requested")
    if len(refs) > MAX_REFS:
        raise Error(f"too many secrets in one request (max {MAX_REFS})")
    for name, ref in refs.items():
        if not isinstance(name, str) or not isinstance(ref, str):
            raise Error("names and references must be strings")
        check_name(name)
        check_ref(ref)


def parse_assignments(args):
    refs = {}
    for arg in args:
        name, sep, ref = arg.partition("=")
        if not sep:
            raise Error(f"expected NAME=op://..., got {arg!r}")
        refs[name] = ref
    check_refs(refs)
    return refs


def parse_ps_line(line):
    m = PS_LINE_RE.match(line)
    if not m:
        return None
    start = calendar.timegm(
        time.strptime(" ".join(m.group(3).split()), "%a %b %d %H:%M:%S %Y")
    )
    return int(m.group(1)), int(m.group(2)), start, m.group(4).strip()


def process_table():
    """One consistent snapshot of every process: pid -> (ppid, start, program).
    `comm` is the program without its arguments, which may hold secrets and
    end up in the log. LC_ALL=C because `lstart` is printed in the user's
    language otherwise."""
    out = subprocess.run(
        ["/bin/ps", "-ww", "-A", "-o", "pid=,ppid=,lstart=,comm="],
        capture_output=True,
        text=True,
        # UTC: in local time the hour repeated when DST ends could make a
        # parent look younger than its child, and the request be refused.
        env={"LC_ALL": "C", "TZ": "UTC0", "PATH": "/usr/bin:/bin"},
        check=True,
    ).stdout
    table = {}
    for line in out.splitlines():
        parsed = parse_ps_line(line)
        if parsed:
            pid, ppid, start, command = parsed
            table[pid] = (ppid, start, command)
    return table


def peer_pid(conn):
    """PID of the process on the other end of a connected Unix socket. Linux
    records the process that called connect(); macOS reports the last process
    to use the peer's socket, which is the connector unless the socket was
    handed to another process. Either way the ancestry check applies to it."""
    if hasattr(socket, "SO_PEERCRED"):  # Linux: struct ucred {pid, uid, gid}
        creds = conn.getsockopt(
            socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")
        )
        return struct.unpack("3i", creds)[0]
    return struct.unpack("i", conn.getsockopt(SOL_LOCAL, LOCAL_PEERPID, 4))[0]


def ancestry(table, pid):
    """The chain from pid up to launchd, stopping at a loop or an unknown PID."""
    chain, seen = [], set()
    while pid in table and pid not in seen:
        seen.add(pid)
        chain.append(pid)
        pid = table[pid][0]
    return chain


def is_descendant(table, pid, ancestor, ancestor_start):
    """True if `ancestor` (with exactly that start time) is in pid's chain and
    every parent along the way started no later than its child, which rules
    out a reused PID."""
    chain = ancestry(table, pid)
    for child, parent in zip(chain, chain[1:] + [None]):
        if child == ancestor:
            return table[child][1] == ancestor_start
        if parent is None or parent not in table:
            return False
        if table[parent][1] > table[child][1]:
            return False
    return False


def describe_chain(table, pid):
    return [f"{p}:{table[p][2]}" for p in ancestry(table, pid)]


def scrypt_hash(value, salt):
    return hashlib.scrypt(value.encode(), salt=salt, n=2**14, r=8, p=1, dklen=16).hex()


# ---------------------------------------------------------------- fetching


def build_template(refs, delim):
    parts = [f"{delim}{i}{delim}{{{{ {ref} }}}}" for i, ref in enumerate(refs)]
    return "".join(parts) + f"{delim}END"


def parse_injected(output, refs, delim):
    """Split `op inject` output on the random delimiter. Values may contain
    newlines; they can't contain the 32-hex delimiter."""
    parts = output.split(delim)
    expected = 2 + 2 * len(refs)
    if len(parts) != expected or parts[0] != "" or parts[-1].rstrip("\n") != "END":
        raise Error("unexpected op inject output")
    values = {}
    for i, ref in enumerate(refs):
        if parts[1 + 2 * i] != str(i):
            raise Error("unexpected op inject output")
        value = parts[2 + 2 * i]
        if "{{" in value and "op://" in value:
            raise Error(f"{ref} was not resolved by op inject")
        values[ref] = value
    return values


def op_inject(refs):
    """Resolve refs in one `op inject` process: one Touch ID prompt."""
    env = clean_env()
    op = shutil.which("op", path=env["PATH"])
    if not op:
        raise Error("1Password CLI (op) not found")
    delim = secrets.token_hex(16)
    try:
        # A fresh process session per call: 1Password reuses an approval for
        # later `op` calls from the same session for ~10 minutes, which would
        # let new secrets through without Touch ID.
        result = subprocess.run(
            [op, "inject"],
            check=False,
            input=build_template(refs, delim).encode(),
            capture_output=True,
            env=env,
            cwd="/",
            timeout=OP_TIMEOUT,
            start_new_session=True,
        )
    except subprocess.TimeoutExpired:
        raise Error("1Password did not answer in time") from None
    if result.returncode != 0:
        message = (
            " ".join(result.stderr.decode(errors="replace").split())[:500]
            or f"op inject exited {result.returncode}"
        )
        raise Error(f"1Password: {message}")
    # Decoding bytes keeps \r and \r\n inside values exactly as stored.
    return parse_injected(result.stdout.decode(), refs, delim)


# ---------------------------------------------------------------- helper


class Helper:
    def __init__(self, session, claude_pid, fetch=op_inject):
        self.session = session
        self.claude_pid = claude_pid
        self.fetch = fetch
        self.paths = helper_paths(session, claude_pid)
        self.cache = {}
        self.denied = {}
        self.salt = os.urandom(16)
        self.token = None
        self.lock_fd = None
        self.server = None
        self.claude_start = None
        self.last_touch = time.monotonic()

    def log(self, event, **fields):
        fd = os.open(self.paths["log"], os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(
                json.dumps(
                    {"t": time.strftime("%Y-%m-%dT%H:%M:%S"), "event": event, **fields}
                )
                + "\n"
            )

    def acquire_lock(self):
        """Kernel lock: released automatically if this process dies, so a
        crashed helper never blocks its session."""
        fd = os.open(self.paths["lock"], os.O_RDWR | os.O_CREAT, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError as e:
            os.close(fd)
            if e.errno in (errno.EWOULDBLOCK, errno.EAGAIN):
                return False
            raise
        os.ftruncate(fd, 0)
        os.write(fd, f"{os.getpid()}\n".encode())
        self.lock_fd = fd
        return True

    def start(self):
        if not self.acquire_lock():
            return False
        table = process_table()
        if self.claude_pid not in table:
            raise Error(f"Claude process {self.claude_pid} is not running")
        self.claude_start = table[self.claude_pid][1]
        for kind in ("sock", "token"):
            try:
                os.unlink(self.paths[kind])
            except FileNotFoundError:
                pass
        self.token = secrets.token_hex(16)
        fd = os.open(self.paths["token"], os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(self.token)
        # The token exists before the socket, so a client that can connect can
        # always read it.
        self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.server.bind(self.paths["sock"])
        os.chmod(self.paths["sock"], 0o600)
        self.server.listen(16)
        self.server.settimeout(POLL_INTERVAL)
        self.log(
            "start",
            helper_pid=os.getpid(),
            claude_pid=self.claude_pid,
            claude_start=self.claude_start,
            op=shutil.which("op", path=clean_env()["PATH"]),
        )
        return True

    def claude_alive(self):
        try:
            os.kill(self.claude_pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            pass
        entry = process_table().get(self.claude_pid)
        return entry is not None and entry[1] == self.claude_start

    def refresh_files(self):
        """Update the timestamps on this helper's files so the /tmp cleaner
        never sees them as abandoned."""
        for kind in ("sock", "token", "lock", "log"):
            try:
                os.utime(self.paths[kind])
            except FileNotFoundError:
                pass
        self.last_touch = time.monotonic()

    def serve_forever(self):
        # Checked on a clock as well as when idle, so steady requests can't
        # keep a helper alive after its Claude process ends.
        next_check = time.monotonic() + POLL_INTERVAL
        while True:
            now = time.monotonic()
            if now - self.last_touch >= TOUCH_INTERVAL:
                self.refresh_files()
            if now >= next_check:
                if not self.claude_alive():
                    self.log("exit", reason="Claude process ended")
                    return
                next_check = now + POLL_INTERVAL
            try:
                conn, _ = self.server.accept()
            except TimeoutError:
                next_check = 0
                continue
            with conn:
                try:
                    self.handle(conn)
                # One bad connection must not end the helper, whatever it raised.
                except Exception as e:  # noqa: BLE001
                    self.log("error", error=f"{type(e).__name__}: {e}")

    def cleanup(self):
        if self.server:
            self.server.close()
        for kind in ("sock", "token", "lock"):
            try:
                os.unlink(self.paths[kind])
            except FileNotFoundError:
                pass
        if self.lock_fd is not None:
            os.close(self.lock_fd)
            self.lock_fd = None

    def handle(self, conn):
        conn.settimeout(CONN_TIMEOUT)
        peer = peer_pid(conn)
        table = process_table()
        chain = describe_chain(table, peer)
        if not is_descendant(table, peer, self.claude_pid, self.claude_start):
            self.log("denied", reason="not part of this session", chain=chain)
            self.reply(
                conn,
                {
                    "ok": False,
                    "error": "refused: requester is not part of this Claude session",
                },
            )
            return
        try:
            request = self.read_request(conn)
            if not hmac.compare_digest(
                str(request.get("token", "")).encode(), self.token.encode()
            ):
                self.log("denied", reason="bad token", chain=chain)
                raise Error("refused: wrong or missing session token")
            response = self.dispatch(request, chain)
        except Error as e:
            response = {"ok": False, "error": str(e)}
        except TimeoutError:
            return
        self.reply(conn, response)

    @staticmethod
    def read_request(conn):
        data = b""
        while not data.endswith(b"\n"):
            chunk = conn.recv(65536)
            if not chunk:
                break
            data += chunk
            if len(data) > MAX_REQUEST:
                raise Error("request too large")
        try:
            request = json.loads(data)
        except ValueError:
            raise Error("malformed request") from None
        if not isinstance(request, dict):
            raise Error("malformed request")
        return request

    @staticmethod
    def reply(conn, response):
        try:
            conn.sendall(json.dumps(response).encode() + b"\n")
        except OSError:
            pass  # The client gave up; anything fetched stays cached.

    def dispatch(self, request, chain):
        op = request.get("op")
        if op == "forget":
            ref = request.get("ref", "")
            check_ref(ref)
            dropped = self.cache.pop(ref, None) is not None
            self.log("forgot", refs=[ref], chain=chain)
            return {"ok": True, "forgotten": dropped}
        if op not in ("get", "check"):
            raise Error(f"unknown request {op!r}")
        refs = request.get("refs")
        check_refs(refs)
        values = self.resolve(refs, chain)
        if op == "get":
            return {"ok": True, "values": values}
        compare = request.get("compare")
        checks = {}
        for name, value in values.items():
            if compare is None:
                checks[name] = {
                    "length": len(value),
                    "scrypt": scrypt_hash(value, self.salt),
                }
            else:
                checks[name] = {
                    "length": len(value),
                    "compare_length": len(compare),
                    "matches": hmac.compare_digest(
                        value.encode(), str(compare).encode()
                    ),
                }
        return {"ok": True, "checks": checks}

    def resolve(self, refs, chain):
        wanted = list(dict.fromkeys(refs.values()))
        missing = [ref for ref in wanted if ref not in self.cache]
        now = time.monotonic()
        for ref in missing:
            if ref in self.denied and now - self.denied[ref][0] < DENY_MEMORY:
                ago = int(now - self.denied[ref][0])
                raise Error(
                    f"{ref} failed {ago}s ago ({self.denied[ref][1]}); ask the user before trying again"
                )
        if missing:
            try:
                fetched = self.fetch(missing)
            # Any failure, not just ours: an unexpected one would otherwise
            # bring up Touch ID again on every retry.
            except Exception as e:  # noqa: BLE001
                err = (
                    e
                    if isinstance(e, Error)
                    # The type only: the message could quote 1Password's output.
                    else Error(
                        f"could not read 1Password's answer ({type(e).__name__})"
                    )
                )
                for ref in missing:
                    self.denied[ref] = (time.monotonic(), str(err))
                self.log("fetch_failed", refs=missing, error=str(err), chain=chain)
                raise err from None
            short = [ref for ref in missing if len(fetched[ref]) < MIN_SECRET_LEN]
            for ref in short:
                self.denied[ref] = (time.monotonic(), "value too short to mask")
            self.cache.update(
                {ref: v for ref, v in fetched.items() if ref not in short}
            )
            self.log(
                "fetched", refs=[r for r in missing if r not in short], chain=chain
            )
            if short:
                raise Error(
                    f"refusing values shorter than {MIN_SECRET_LEN} characters "
                    f"(output masking can't hide them): {', '.join(short)}"
                )
        else:
            self.log("served", refs=wanted, chain=chain)
        return {name: self.cache[ref] for name, ref in refs.items()}


def cmd_serve(args):
    if len(args) != 4 or args[0] != "--session" or args[2] != "--claude-pid":
        raise Error("usage: op-secret serve --session ID --claude-pid PID")
    session, claude_pid = args[1], int(args[3])
    if not SESSION_RE.fullmatch(session):
        raise Error("invalid session ID")
    if claude_pid <= 1:
        # Every process descends from PID 1, so this would let anything in.
        raise Error("invalid Claude PID")
    helper = Helper(session, claude_pid)

    def on_term(signum, frame):
        raise SystemExit(0)

    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, on_term)
    try:
        if not helper.start():
            return 0  # Another helper for this session won the race.
        helper.serve_forever()
    finally:
        # The files belong to whichever helper holds the lock; a loser must
        # not delete the winner's socket and token.
        if helper.lock_fd is not None:
            helper.cleanup()
    return 0


# ---------------------------------------------------------------- client


def session_identity():
    session = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    pid = os.environ.get("CLAUDE_PID", "")
    if not session or not pid.isdigit():
        raise Error(
            "op-secret only works inside a Claude Code session (CLAUDE_CODE_SESSION_ID and CLAUDE_PID are not set)"
        )
    if not SESSION_RE.fullmatch(session):
        raise Error("invalid CLAUDE_CODE_SESSION_ID")
    if int(pid) <= 1:
        raise Error("invalid CLAUDE_PID")
    return session, int(pid)


def log_tail(path, lines=10):
    try:
        with open(path) as f:
            return "".join(f.readlines()[-lines:])
    except OSError:
        return ""


def connect():
    session, claude_pid = session_identity()
    paths = helper_paths(session, claude_pid)
    deadline = None
    while True:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            sock.connect(paths["sock"])
            return sock, paths
        except (FileNotFoundError, ConnectionRefusedError):
            sock.close()
        if deadline is None:
            log = os.open(paths["log"], os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            subprocess.Popen(
                [
                    sys.executable,
                    "-I",
                    os.path.realpath(__file__),
                    "serve",
                    "--session",
                    session,
                    "--claude-pid",
                    str(claude_pid),
                ],
                env=clean_env(),
                cwd="/",
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=log,
                start_new_session=True,
                close_fds=True,
            )
            os.close(log)
            deadline = time.monotonic() + CONNECT_WAIT
        elif time.monotonic() > deadline:
            raise Error(
                f"could not start the op-secret helper. Log:\n{log_tail(paths['log'])}"
            )
        time.sleep(0.1)


def request(payload):
    sock, paths = connect()
    with sock:
        try:
            with open(paths["token"]) as f:
                payload["token"] = f.read().strip()
        except OSError:
            raise Error(
                "helper token missing; run `op-secret stop --pid $CLAUDE_PID` and retry"
            ) from None
        sock.settimeout(CLIENT_WAIT)
        sock.sendall(json.dumps(payload).encode() + b"\n")
        data = b""
        try:
            while not data.endswith(b"\n"):
                chunk = sock.recv(65536)
                if not chunk:
                    break
                data += chunk
        except TimeoutError:
            raise Error(
                "timed out waiting for 1Password. If you approve the prompt late, "
                "the secret is still cached and the next request won't prompt."
            ) from None
    try:
        response = json.loads(data)
    except ValueError:
        raise Error("no answer from the op-secret helper") from None
    if not response.get("ok"):
        raise Error(response.get("error", "request failed"))
    return response


class Masker:
    """Replaces every exact occurrence of a secret with <concealed>. Holds back
    only a tail that could still become a secret (including a full secret that
    could still grow into a longer one), so a short line followed by a pause
    still appears immediately. A confirmed secret is concealed as soon as it's
    seen, even if more output may extend it, so overlapping repeats can't grow
    the buffer without limit."""

    def __init__(self, values):
        self.secrets = sorted({v for v in values if v}, key=len, reverse=True)
        self.maxlen = max((len(s) for s in self.secrets), default=0)
        self.buf = b""
        # buf[:done] was already concealed; it stays only as context, so a
        # secret continuing from it is recognised and never printed.
        self.done = 0

    def _keep(self, buf, start, i):
        self.buf = buf[start:]
        self.done = max(0, i - start)

    def _process(self, final):
        buf, out, i, search = self.buf, bytearray(), self.done, 0
        while True:
            match = None  # earliest full occurrence, longest at that position
            for s in self.secrets:
                j = buf.find(s, search)
                if j != -1 and (match is None or j < match[0]):
                    match = (j, s)
            if match is not None:
                j, s = match
                end = j + len(s)
                # Extend over any secret that starts inside this match and
                # runs past it, so no part of either stays visible.
                grown = True
                while grown:
                    grown = False
                    for other in self.secrets:
                        k = buf.find(other, j + 1)
                        while k != -1 and k < end:
                            if k + len(other) > end:
                                end, grown = k + len(other), True
                            k = buf.find(other, k + 1)
                if end <= i:  # Entirely inside what's already concealed.
                    search = j + 1
                    continue
            cut = None  # earliest start of a match that more input could extend
            if not final:
                for pos in range(max(0, len(buf) - self.maxlen + 1), len(buf)):
                    tail = buf[pos:]
                    if any(
                        len(s) > len(tail) and s.startswith(tail) for s in self.secrets
                    ):
                        cut = pos
                        break
            if cut is not None and (match is None or cut < end):
                if match is not None and j < cut:
                    # The secret is confirmed: conceal it now and keep only
                    # the part more input could extend, marked as concealed.
                    if j >= i:
                        out += buf[i:j] + MASK
                    self._keep(buf, cut, end)
                    return bytes(out)
                # Wait for more input: the possible match starts before any
                # complete one. What's held is shorter than the longest secret.
                start = cut if match is None else min(cut, j)
                if start > i:
                    out += buf[i:start]
                self._keep(buf, start, i)
                return bytes(out)
            if match is None:
                out += buf[i:]
                self._keep(buf, len(buf), len(buf))
                return bytes(out)
            if j >= i:  # A secret continuing a concealed one needs no new mark.
                out += buf[i:j] + MASK
            i = search = end

    def feed(self, data):
        if not self.secrets:
            return data
        self.buf += data
        return self._process(final=False)

    def finish(self):
        return self._process(final=True)


def pump(src, dst, masker):
    try:
        while True:
            data = os.read(src.fileno(), 65536)
            if not data:
                break
            out = masker.feed(data)
            if out:
                dst.write(out)
                dst.flush()
        dst.write(masker.finish())
        dst.flush()
    except BrokenPipeError:
        # Whoever reads our output went away (`| head`). Close the child's
        # pipe so its next write fails and it ends, as in a shell pipeline,
        # and point our stream at /dev/null so exit-time flushes stay quiet.
        src.close()
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, dst.fileno())
        os.close(devnull)


def cmd_run(args):
    if "--" not in args:
        raise Error("usage: op-secret run NAME=op://... [...] -- COMMAND [ARGS...]")
    split = args.index("--")
    refs, command = parse_assignments(args[:split]), args[split + 1 :]
    if not command:
        raise Error("no command given after --")
    values = request({"op": "get", "refs": refs})["values"]
    env = dict(os.environ)
    env.update(values)
    secrets_bytes = [v.encode() for v in values.values()]
    del values
    # Handlers go in before the command starts; a signal that arrives while
    # it's starting is passed on as soon as it exists.
    started, pending = [], []

    def forward(signum, frame):
        if started:
            started[0].send_signal(signum)
        else:
            pending.append(signum)

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, forward)
    try:
        proc = subprocess.Popen(
            command, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE
        )
    except OSError as e:
        raise Error(f"could not run {command[0]}: {e.strerror}") from None
    del env
    started.append(proc)
    for signum in pending:
        proc.send_signal(signum)
    threads = [
        threading.Thread(
            target=pump, args=(proc.stdout, sys.stdout.buffer, Masker(secrets_bytes))
        ),
        threading.Thread(
            target=pump, args=(proc.stderr, sys.stderr.buffer, Masker(secrets_bytes))
        ),
    ]
    for t in threads:
        t.daemon = True
        t.start()
    rc = proc.wait()
    code = rc if rc >= 0 else 128 - rc
    deadline = time.monotonic() + 2
    for t in threads:
        t.join(max(0, deadline - time.monotonic()))
    if any(t.is_alive() for t in threads):
        # The command exited but something it started still holds our pipes
        # open. Don't wait on it; exit now without the normal shutdown, which
        # could block on those threads.
        for stream in (sys.stdout, sys.stderr):
            try:
                stream.flush()
            except OSError:
                pass
        os._exit(code)
    return code


def cmd_check(args):
    use_stdin = bool(args) and args[0] == "--stdin"
    refs = parse_assignments(args[1:] if use_stdin else args)
    payload = {"op": "check", "refs": refs}
    if use_stdin:
        if len(refs) != 1:
            raise Error("--stdin compares exactly one secret")
        compare = sys.stdin.read()
        payload["compare"] = compare.removesuffix("\n")
    for name, result in request(payload)["checks"].items():
        if use_stdin:
            verdict = "matches" if result["matches"] else "differs"
            print(
                f"{name}: {verdict} (1Password length {result['length']}, stdin length {result['compare_length']})"
            )
        else:
            print(f"{name}: length {result['length']}, scrypt {result['scrypt']}")
    return 0


def cmd_forget(args):
    if len(args) != 1:
        raise Error("usage: op-secret forget op://vault/item/field")
    check_ref(args[0])
    forgotten = request({"op": "forget", "ref": args[0]})["forgotten"]
    print(f"forgot {args[0]}" if forgotten else f"{args[0]} was not cached")
    return 0


# ---------------------------------------------------------------- list / stop


def helpers():
    """Every helper with files in the runtime dir, from its log and lock."""
    found = []
    for entry in sorted(os.listdir(runtime_dir())):
        if not entry.endswith(".log"):
            continue
        base = entry[: -len(".log")]
        session, _, claude_pid = base.rpartition("-")
        paths = {
            kind: os.path.join(RUNTIME_DIR, f"{base}.{kind}")
            for kind in ("sock", "token", "lock", "log")
        }
        helper_pid, held = None, set()
        try:
            with open(paths["lock"]) as f:
                helper_pid = int(f.read().strip() or 0) or None
        except (OSError, ValueError):
            pass
        with open(paths["log"]) as f:
            for line in f:
                try:
                    record = json.loads(line)
                except ValueError:
                    continue
                if record.get("event") == "start":
                    held.clear()  # A new helper starts with nothing cached.
                elif record.get("event") == "fetched":
                    held.update(record.get("refs", []))
                elif record.get("event") == "forgot":
                    held.difference_update(record.get("refs", []))
        alive = helper_pid is not None and is_our_helper(helper_pid)
        found.append(
            {
                "session": session,
                "claude_pid": claude_pid,
                "helper_pid": helper_pid,
                "alive": alive,
                "held": sorted(held),
                "paths": paths,
            }
        )
    return found


def is_our_helper(pid):
    """Check the PID still belongs to an op-secret helper, so a reused PID is
    never signalled."""
    result = subprocess.run(
        ["/bin/ps", "-ww", "-o", "command=", "-p", str(pid)],
        check=False,
        capture_output=True,
        text=True,
        # No COLUMNS: Linux ps cuts the line to it, which could hide
        # "op-secret serve" behind a long path.
        env={"LC_ALL": "C", "PATH": "/usr/bin:/bin"},
    )
    return "op-secret serve" in result.stdout


def cmd_list(args):
    # Nothing here deletes files: a helper removes its own when it exits, and
    # files left by a crashed helper go away at the next reboot.
    for h in helpers():
        if not h["alive"]:
            print(
                f"session {h['session']}  claude pid {h['claude_pid']}  (stopped; leftover files)"
            )
            continue
        print(
            f"session {h['session']}  claude pid {h['claude_pid']}  helper pid {h['helper_pid']}"
        )
        for ref in h["held"]:
            print(f"    {ref}")
        if not h["held"]:
            print("    (no secrets held)")
    return 0


def cmd_stop(args):
    if args == ["--all"]:
        match = lambda h: True
    elif len(args) == 2 and args[0] == "--session":
        match = lambda h: h["session"] == args[1]
    elif len(args) == 2 and args[0] == "--pid":
        match = lambda h: h["claude_pid"] == args[1] or str(h["helper_pid"]) == args[1]
    else:
        raise Error("usage: op-secret stop --session ID | --pid N | --all")
    stopped = 0
    for h in helpers():
        if h["alive"] and match(h):
            os.kill(h["helper_pid"], signal.SIGTERM)
            print(
                f"stopped helper {h['helper_pid']} (session {h['session']}, claude pid {h['claude_pid']})"
            )
            stopped += 1
    if not stopped:
        print("no matching helper running")
    return 0


COMMANDS = {
    "run": cmd_run,
    "check": cmd_check,
    "forget": cmd_forget,
    "list": cmd_list,
    "stop": cmd_stop,
    "serve": cmd_serve,
}


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    try:
        return COMMANDS[argv[0]](argv[1:])
    except Error as e:
        print(f"op-secret: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
