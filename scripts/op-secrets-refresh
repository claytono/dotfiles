#!/usr/bin/env bash
# Drop the op_secrets cache for a repo so direnv fetches fresh values from
# 1Password on the next load. Use after rotating a secret.
#
# Usage: op-secrets-refresh [dir]   (defaults to the current directory)
#
# The repo is the nearest directory at or above [dir] containing an .envrc,
# matching how direnv finds it.

set -euo pipefail

repo=$(cd "${1:-.}" && pwd -P)
until [[ -f $repo/.envrc ]]; do
	if [[ $repo == / ]]; then
		echo "No .envrc found at or above ${1:-.}" >&2
		exit 1
	fi
	repo=$(dirname "$repo")
done

# direnv evaluates .envrc from its physical directory, which the library
# records in each cache file's first line.
removed=0
shopt -s nullglob
for f in "/tmp/op-secrets-${USER:-$(id -un)}"/*; do
	if [[ $(head -n 1 "$f") == "# op_secrets dir=$repo" ]]; then
		rm -f "$f"
		removed=$((removed + 1))
	fi
done

if ((removed == 0)); then
	echo "No op_secrets cache found for $repo"
	exit 0
fi

echo "Removed op_secrets cache for $repo"
if command -v direnv >/dev/null; then
	(cd "$repo" && direnv reload) || echo "warning: direnv reload failed in $repo" >&2
fi
