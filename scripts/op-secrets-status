#!/usr/bin/env bash
# List op_secrets cache entries (see config/direnv/lib/op-secrets.sh) without
# printing any secret values.

set -euo pipefail

dir="/tmp/op-secrets-${USER:-$(id -un)}"
shopt -s nullglob
entries=("$dir"/*)

if ((${#entries[@]} == 0)); then
	echo "No cached secrets in $dir"
	exit 0
fi

for f in "${entries[@]}"; do
	repo=$(sed -n '1s/^# op_secrets dir=//p' "$f")
	names=$(sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$f" | paste -sd, -)
	modified=$(date -r "$f" '+%Y-%m-%d %H:%M')
	printf '%s\n  vars: %s\n  cached: %s\n  file: %s\n' "${repo:-?}" "$names" "$modified" "$f"
done
