#!/bin/bash

set -e

name=$(basename "$0")
mode_args=()

# CCO only grants additional write access to directories that already exist.
# Create FastEmbed's shared cache before admitting it to the sandbox.
mkdir -p "$HOME/.fastembed_cache"

common_args=(
  --allow-keychain
  --add-dir ~/.plannotator:rw
  --add-dir ~/.cache/gh:rw
  --add-dir ~/.cache/nix:rw
  --add-dir ~/.cache/pre-commit:rw
  --add-dir ~/.cache/uv:rw
  --add-dir ~/.npm:rw
  --add-dir ~/.bun:rw
  --add-dir ~/.gnupg:rw
  --add-dir ~/.docker:rw
  --add-dir ~/.ansible:rw
  --add-dir ~/.config/superpowers:rw
  --add-dir ~/.codex:rw
  --add-dir ~/.local/share/uv:rw
  --add-dir ~/.memex:rw
  --add-dir ~/.fastembed_cache:rw
)
cco_args=("${common_args[@]}")
wrapped_args=()

case "$name" in
  cco-claude)
    mode_args=(--allow-dangerously-skip-permissions)
    ;;
  cco-opencode)
    mode_args=(opencode)
    export OPENCODE_ENABLE_EXA=1
    ;;
  cco-codex)
    mode_args=(codex --dangerously-bypass-approvals-and-sandbox)
    ;;
  *)
    echo "Unsupported wrapper name: $name" >&2
    exit 1
    ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    --add-dir=*)
      cco_args+=("$1")
      shift
      ;;
    --add-dir)
      if [[ $# -lt 2 ]]; then
        echo "--add-dir requires an argument" >&2
        exit 1
      fi
      cco_args+=("$1" "$2")
      shift 2
      ;;
    *)
      wrapped_args+=("$1")
      shift
      ;;
  esac
done

# Tell the agent it is sandboxed so write failures outside the allowed paths
# are reported instead of debugged or worked around.
writable_dirs=()
readonly_dirs=()
keychain=false
for ((i = 0; i < ${#cco_args[@]}; i++)); do
  case "${cco_args[i]}" in
    --add-dir) dir=${cco_args[++i]} ;;
    --add-dir=*) dir=${cco_args[i]#--add-dir=} ;;
    --allow-keychain) keychain=true; continue ;;
    *) continue ;;
  esac
  case "$dir" in
    *:ro) readonly_dirs+=("${dir%:ro}") ;;
    *) writable_dirs+=("${dir%:rw}") ;;
  esac
done

join_paths() {
  local out="" path
  for path in "$@"; do
    out+="${out:+, }${path/#$HOME/~}"
  done
  printf '%s' "$out"
}

sandbox_note="You are running inside the cco sandbox (macOS sandbox-exec). \
The host filesystem is readable but writes are denied except for the \
current project directory, temp directories (/tmp, \$TMPDIR), \
~/Library/{Caches,Logs,Application Support}, and these extra paths: \
$(join_paths "${writable_dirs[@]}")."
if [[ ${#readonly_dirs[@]} -gt 0 ]]; then
  sandbox_note+=" Explicitly read-only: $(join_paths "${readonly_dirs[@]}")."
fi
if [[ "$keychain" == true ]]; then
  sandbox_note+=" macOS Keychain access is allowed."
fi
sandbox_note+=" Network access is unrestricted. If a write fails with \
'Operation not permitted' or similar outside those paths, it is the sandbox, \
not a bug: report it to the user instead of trying to work around it."

case "$name" in
  cco-claude)
    mode_args+=(--append-system-prompt "$sandbox_note")
    ;;
  cco-codex)
    toml_note=${sandbox_note//\\/\\\\}
    toml_note=${toml_note//\"/\\\"}
    mode_args+=(-c "developer_instructions=\"$toml_note\"")
    ;;
esac

exec cco "${cco_args[@]}" "${mode_args[@]}" "${wrapped_args[@]}"
